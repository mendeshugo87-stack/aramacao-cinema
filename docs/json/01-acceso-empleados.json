{
  "modulo": "Acceso de empleados",
  "prefijo": "/api/v1",
  "sesion": "Cookie segura de Django con HttpOnly, Secure en producción y SameSite=Lax",
  "roles": [
    "VENDEDOR_TAQUILLA",
    "CONTROL_ACCESO",
    "ADMINISTRADOR_OPERATIVO"
  ],
  "ruta_por_rol": {
    "VENDEDOR_TAQUILLA": "/pages/taquilla/",
    "ADMINISTRADOR_OPERATIVO": "/pages/gestion/",
    "CONTROL_ACCESO": "/pages/control-entrada/"
  },
  "endpoints": [
    {
      "metodo": "GET",
      "ruta": "/api/v1/autenticacion/csrf/",
      "requiere_sesion": false,
      "hace": "Prepara la cookie CSRF.",
      "respuesta_correcta": "204 Sin contenido"
    },
    {
      "metodo": "POST",
      "ruta": "/api/v1/autenticacion/empleados/iniciar-sesion/",
      "requiere_sesion": false,
      "entrada": {
        "usuario": "hugo69",
        "contrasena": "solo_por_https"
      },
      "respuesta_200": {
        "empleado": {
          "id": "uuid",
          "codigo_empleado": "TAQ-001",
          "usuario": "hugo69",
          "nombre_completo": "Hugo Méndez",
          "rol": "VENDEDOR_TAQUILLA",
          "nombre_rol": "Vendedor de taquilla",
          "permisos": [
            "ventas.crear_venta",
            "ventas.consultar_turno_propio"
          ]
        },
        "debe_cambiar_contrasena": false,
        "ruta_siguiente": "/pages/taquilla/"
      }
    },
    {
      "metodo": "GET",
      "ruta": "/api/v1/autenticacion/empleados/sesion-actual/",
      "requiere_sesion": true,
      "respuesta_200": {
        "autenticado": true,
        "debe_cambiar_contrasena": false,
        "empleado": "Mismo objeto empleado devuelto al iniciar sesión"
      }
    },
    {
      "metodo": "POST",
      "ruta": "/api/v1/autenticacion/empleados/cambiar-contrasena/",
      "requiere_sesion": true,
      "entrada": {
        "contrasena_actual": "contraseña_temporal",
        "contrasena_nueva": "contraseña_personal"
      },
      "respuesta_200": {
        "mensaje": "Contraseña actualizada correctamente.",
        "ruta_siguiente": "/pages/taquilla/"
      }
    },
    {
      "metodo": "POST",
      "ruta": "/api/v1/autenticacion/empleados/cerrar-sesion/",
      "requiere_sesion": true,
      "respuesta_200": {
        "mensaje": "Sesión cerrada correctamente."
      }
    }
  ],
  "errores_principales": {
    "400": "ERROR_VALIDACION",
    "401": "CREDENCIALES_INVALIDAS o AUTENTICACION_REQUERIDA",
    "403": "CUENTA_INACTIVA, ROL_NO_PERMITIDO o CSRF_INVALIDO",
    "429": "DEMASIADOS_INTENTOS"
  },
  "regla_administrador_operativo": "Usa este mismo inicio de sesión, pero Django devuelve rol ADMINISTRADOR_OPERATIVO, sus permisos y la ruta /pages/gestion/.",
  "permisos_por_rol": {
    "VENDEDOR_TAQUILLA": [
      "ventas.crear_venta",
      "ventas.consultar_turno_propio"
    ],
    "CONTROL_ACCESO": [
      "boletos.escanear"
    ],
    "ADMINISTRADOR_OPERATIVO": [
      "cartelera.gestionar",
      "personal.gestionar"
    ]
  },
  "regla_control_acceso": "Usa el mismo inicio de sesión. Django devuelve rol CONTROL_ACCESO, permiso boletos.escanear y ruta /pages/control-entrada/."
}
