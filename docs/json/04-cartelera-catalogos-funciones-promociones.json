      "respuesta_200": "Funciones publicadas de una pelicula para la fecha."
    },
    {
      "metodo": "GET",
      "ruta": "/api/v1/cartelera/promociones/activas/",
      "query": "fecha=YYYY-MM-DD&pelicula_id={id}",
