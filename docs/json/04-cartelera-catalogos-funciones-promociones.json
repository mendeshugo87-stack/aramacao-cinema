      {"metodo": "PATCH", "ruta": "/api/v1/administracion/generos/{id}/estado/", "body": {"activo": false}, "respuesta": "200 catalogo", "permiso": "cartelera.generos.cambiar_estado"}
    ],
    "actores": [
