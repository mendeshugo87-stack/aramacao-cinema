      {"metodo": "POST", "ruta": "/api/v1/administracion/peliculas/", "content_type": "application/json", "body": "pelicula_peticion", "respuesta": "201 pelicula_respuesta", "permiso": "cartelera.peliculas.crear"},
      {"metodo": "GET", "ruta": "/api/v1/administracion/peliculas/{id}/", "respuesta": "200 pelicula_respuesta", "permiso": "cartelera.peliculas.ver"},
