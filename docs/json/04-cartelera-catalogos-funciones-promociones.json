      "seccion en CARTELERA, PROXIMAMENTE o RETIRADA",
      "visibilidad_fondo_porcentaje entre 35 y 85",
      "trailer_url debe ser una URL permitida"
    ],
    "imagenes": [
      "poster con proporcion final 2:3 y minimo recomendado de 1000x1500",
      "fondo con proporcion final 16:7 y minimo recomendado de 1920x840",
