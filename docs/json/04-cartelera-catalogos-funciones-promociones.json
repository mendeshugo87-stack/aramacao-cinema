      {"metodo": "POST", "ruta": "/api/v1/administracion/peliculas/{id}/imagenes/", "content_type": "multipart/form-data", "body": "imagenes_pelicula_multipart", "respuesta": {"poster_url": "url-o-null", "fondo_inicio_url": "url-o-null", "visibilidad_fondo_porcentaje": 65}, "permiso": "cartelera.peliculas.editar_imagenes"}
