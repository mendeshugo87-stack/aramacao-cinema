    "funciones": [
      "fecha YYYY-MM-DD, hora HH:MM, formato 2D o 3D y precio mayor o igual a cero",
      "Sala 1 se asigna en backend",
      "no permitir cruces de horario",
      "venta_hasta se calcula como hora_inicio mas 20 minutos"
    ],
    "promocion_2x1": [
      "periodo valido y al menos una pelicula",
      "dias limitados a LUNES, MARTES y MIERCOLES",
