  "endpoints_publicos": [
    {
      "metodo": "GET",
      "ruta": "/api/v1/cartelera/peliculas/",
      "query": "seccion=CARTELERA|PROXIMAMENTE&fecha=YYYY-MM-DD&buscar=texto",
      "respuesta_200": "Lista paginada de pelicula_respuesta; solo contenido activo y publicado."
    },
    {
      "metodo": "GET",
      "ruta": "/api/v1/cartelera/peliculas/{id}/",
      "respuesta_200": "pelicula_respuesta con sus catalogos relacionados."
    },
    {
      "metodo": "GET",
      "ruta": "/api/v1/cartelera/funciones/",
      "query": "fecha=YYYY-MM-DD&pelicula_id={id}",
      "respuesta_200": "Lista de funcion_respuesta publicadas."
    },
    {
      "metodo": "GET",
      "ruta": "/api/v1/cartelera/peliculas/{id}/funciones/",
