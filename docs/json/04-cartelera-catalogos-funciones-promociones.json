      {"metodo": "DELETE", "ruta": "/api/v1/administracion/funciones/{id}/", "respuesta": "204 si no tiene ventas; 409 FUNCION_CON_VENTAS si ya tiene historial", "permiso": "cartelera.funciones.retirar"}
